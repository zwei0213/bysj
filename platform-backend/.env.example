APP_ENV=production
DATABASE_URL=postgresql+psycopg://slp_user:REPLACE_DB_PASSWORD@127.0.0.1:5432/smart_learning
CORS_ALLOWED_ORIGINS=https://learn.example.com

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_EXPIRE_HOURS=12
JWT_REFRESH_EXPIRE_DAYS=14

AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=REPLACE_WITH_STRONG_AI_BUSINESS_SERVICE_KEY
AI_OPS_KEY=REPLACE_WITH_STRONG_AI_OPERATIONS_KEY
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_STRONG_WEBHOOK_HMAC_SECRET
PLATFORM_CALLBACK_URL=http://127.0.0.1:8000/internal/v1/webhooks/ai-jobs

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

MAX_VIDEO_UPLOAD_MB=2048
MAX_DOCUMENT_UPLOAD_MB=100

# 可选：直接在业务后端配置大模型与 API 密钥（启动时自动通过 /v1/ops/runtime-config 下发同步至 AI 服务）
AI_PROVIDER=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ASR_PROVIDER=
WHISPER_MODEL_SIZE=
