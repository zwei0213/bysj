# ============================================================================
# 智能学习平台 (Smart Learning Platform v1.0) — 商业服务器 Docker Compose 环境变量模板
# 推荐直接运行: python3 scripts/init-prod-env.py --domain https://learn.example.com
# 自动生成包含 256-bit 随机高强度密钥的正式 .env 文件
# ============================================================================

# 1. 对外访问端口与商业前端域名（多域名用英文逗号分隔，严禁填 *）
HTTP_PORT=80
CORS_ALLOWED_ORIGINS=https://learn.example.com

# 2. PostgreSQL 16 生产业务数据库凭证（仅工程团队后端连接，AI 服务物理隔离不可见）
POSTGRES_DB=smart_learning
POSTGRES_USER=slp_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DB_PASSWORD
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
UVICORN_WORKERS=2

# 3. 工程后端认证与首次空库初始化的唯一超级管理员凭证
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_EXPIRE_HOURS=12
JWT_REFRESH_EXPIRE_DAYS=14
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MAX_VIDEO_UPLOAD_MB=2048
MAX_DOCUMENT_UPLOAD_MB=100

# 4. 工程后端 <-> AI 助教服务 双平面物理隔离鉴权密钥与 Webhook HMAC 签名密钥
# 注意：AI_SERVICE_KEY 与 AI_OPS_KEY 严禁相同，且长度均须 >= 24 字符
AI_SERVICE_KEY=REPLACE_WITH_STRONG_AI_BUSINESS_SERVICE_KEY
AI_OPS_KEY=REPLACE_WITH_STRONG_AI_OPERATIONS_KEY
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_STRONG_WEBHOOK_HMAC_SECRET

# 5. 大模型与向量检索配置（未填 API Key 时自动启用离线混合检索与本地 Faster-Whisper）
# AI_PROVIDER 可选: local | openai (兼容 OpenAI / DeepSeek / 通义千问 / 私有化 vLLM) | gemini
AI_PROVIDER=local
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ASR_MODEL=whisper-1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 6. 课程视频语音转写 (ASR) 与算力并发配置
# ASR_PROVIDER 可选: auto | openai | gemini | local_whisper
ASR_PROVIDER=auto
WHISPER_MODEL_SIZE=base
# 若配备 NVIDIA GPU，请改为 WHISPER_DEVICE=cuda 及 WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
HF_ENDPOINT=https://hf-mirror.com
MAX_CONCURRENT_JOBS=2
