# 预发布环境 (.env.staging) 配置模板 —— 工程团队与高校 AI 团队共享联调验收使用
APP_ENV=staging
STAGING_HTTP_PORT=8088
PROMETHEUS_PORT=9090

POSTGRES_DB=smart_learning_staging
POSTGRES_USER=slp_staging
POSTGRES_PASSWORD=ReplaceWithStrongStagingDbPassword_2026!

JWT_SECRET=staging_jwt_secret_replace_before_deploy_0123456789
AI_SERVICE_KEY=staging_ai_service_key_replace_before_deploy_012345
AI_OPS_KEY=staging_ai_ops_key_replace_before_deploy_0123456789
WEBHOOK_SIGNING_SECRET=staging_webhook_secret_replace_before_deploy_012345

CORS_ALLOWED_ORIGINS=http://localhost:8088,https://staging.cracmheart.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=StagingAdmin#2026ChangeMe
BOOTSTRAP_ADMIN_EMAIL=staging-ops@cracmheart.com

AI_PROVIDER=local
ASR_PROVIDER=auto
ENABLE_V2_HARNESS=true
