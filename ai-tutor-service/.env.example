APP_ENV=production
AI_SERVICE_KEY=REPLACE_WITH_STRONG_AI_BUSINESS_SERVICE_KEY
AI_OPS_KEY=REPLACE_WITH_STRONG_AI_OPERATIONS_KEY
WEBHOOK_SIGNING_SECRET=REPLACE_WITH_STRONG_WEBHOOK_HMAC_SECRET

# 文本与向量模型提供方：local | openai (兼容 DeepSeek/通义千问/vLLM/OpenAI) | gemini
AI_PROVIDER=local
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ASR_MODEL=whisper-1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 可选外部向量数据库 Qdrant HTTP 地址（留空默认启用内置 SQLite WAL 稠密+词法混合检索）
QDRANT_URL=
QDRANT_API_KEY=

# 视频语音转写 (ASR) 策略：auto (有云端 API Key 优先走云端，无 Key 自动走本地离线 Faster-Whisper) | openai | gemini | local_whisper
ASR_PROVIDER=auto
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
HF_ENDPOINT=https://hf-mirror.com
MAX_CONCURRENT_JOBS=2

ENABLE_V2_HARNESS=false
ENABLE_V2_PERSONALIZATION=false
ENABLE_V2_RSI=false
